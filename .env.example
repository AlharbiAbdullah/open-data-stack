# Open Data Stack Configuration
# Copy this file to .env and update values as needed

# Stock symbols to track (comma-separated)
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,AMZN,META

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_STOCK_PRICES=stock_prices

# Streaming
STREAMING_INTERVAL_SECONDS=60

# Batch schedule (cron format)
BATCH_SCHEDULE=0 6 * * *
